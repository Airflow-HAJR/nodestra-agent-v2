# LLM provider: "openai" (default) or "azure"
LLM_PROVIDER=openai

# OpenAI (active provider). MAIN = capable model for the agent;
# FAST = small/fast model for helper nodes (intent, recall, save, summary).
OPENAI_API_KEY=your-key-here
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_FAST=gpt-4.1-nano

# Azure OpenAI (only used when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=

# Embedding model behind POI retrieval (agent/poi_rag.py — the write-ups the
# agent quotes when asked whether a restaurant is halal, what time it closes,
# etc). One of these depending on LLM_PROVIDER. With neither set, retrieval
# still works but falls back to keyword matching over the same corpus.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
OPENAI_EMBEDDING_MODEL=2024-12-01-preview

# Supabase (map data + analytics writes + optional Google sign-in)
#
# SUPABASE_URL/SUPABASE_KEY also verify the access tokens the web UI sends when
# a traveler has signed in with Google. No extra credentials are needed: the
# server asks Supabase's own auth API who a token belongs to rather than holding
# the JWT secret. With these unset, everyone is a guest and nothing is
# remembered past the conversation — which is a supported way to run.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key  # needed for analytics + memory writes (bypasses RLS)

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-key

# ElevenLabs (text-to-speech)
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Public URL Twilio can reach (set this to your tunnel URL during local dev)
# Example: https://abcd1234.ngrok-free.app
SERVER_BASE_URL=http://localhost:8000

# Supermemory (persistent user personalization)
SUPERMEMORY_API_KEY=your-supermemory-key

# Moss semantic search
MOSS_PROJECT_ID=your-project-id-here
MOSS_PROJECT_KEY=moss_your-key-here

# Flight hydrator (backend/hydrator/server.py)
# Set FLIGHT_HYDRATION_ENABLED=true to start the hydrator process
# Flight tracker — background loop in server.py that polls gategetter and calls passengers on changes
FLIGHT_TRACKER_ENABLED=false

# Flight hydrator — seeds vector_documents in Supabase from live gategetter scrapes
FLIGHT_HYDRATION_ENABLED=false

GATEGETTER_URL=http://localhost:8081
HYDRATION_AIRPORT=OAK
HYDRATION_INTERVAL_MINUTES=5

# LOCAL DEMOS ONLY. Serve every /web/stream session as this user id with durable
# memory on, whether or not anyone signed in — so a demo can show a returning
# traveler being recognized without a live Google sign-in. This is an auth
# bypass: anyone opening the page gets that user's memories. Never set it in a
# deployed environment. Seed it first:
#   uv run python scripts/seed_demo_memories.py
# DEMO_USER_ID=+15105550142
# Where that traveler is standing when the session opens, so the demo's first
# question can be "what's nearby?" rather than "where are you?".
# DEMO_START_POI=security-4RXW

# Comma-separated origins allowed to call the HTTP API and connect to
# /web/stream. Leave as "*" for local dev; lock down in production,
# e.g. ALLOWED_ORIGINS=https://agent.nodestra.com
ALLOWED_ORIGINS=*

# Groq — optional fast tier for helper nodes (Llama on LPU, ~100-250ms).
# When set, the FAST LLM tier uses Groq instead of OPENAI_MODEL_FAST.
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Main agent model. gpt-4o (default) or a gpt-5.6-* reasoning model.
# Reasoning models REQUIRE reasoning_effort=none to bind tools on chat completions;
# leave OPENAI_MAIN_REASONING_EFFORT empty for gpt-4o.
# OPENAI_MODEL_MAIN=gpt-5.6-luna
# OPENAI_MAIN_REASONING_EFFORT=none
